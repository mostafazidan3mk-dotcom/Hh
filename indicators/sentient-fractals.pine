f_manage_future_vdiv(show_future_vdiv_4h, futureH4Start, color_vdiv_4h, style_vdiv_4h, width_vdiv_4h, h4_future_vdivs)

is_visible_d = f_should_show_fractal(enableTfVisibilityD, maxTfVisibilityD)
