    array.push(ALL_STDV_LEVELS, -neg_level_12), array.push(stdv_show_config, show_neg_12), array.push(stdv_color_config, color_neg_12), array.push(stdv_style_config, style_neg_12), array.push(stdv_extend_config, extend_neg_12)

f_create_outline_lines(start_bar, end_bar, sh, sl, col, lineStyle) =>
    [line.new(start_bar, sl, start_bar, sh, color=col, width=borderWidthInput, style=lineStyle), line.new(end_bar, sl, end_bar, sh, color=col, width=borderWidthInput, style=lineStyle), line.new(start_bar, sh, end_bar, sh, color=col, width=borderWidthInput, style=lineStyle)]

f_update_outline_lines(ref_left, ref_right, sh, sl, col, lineStyle) =>
    lx = line.get_x1(ref_left)
    rx = line.get_x1(ref_right)
    line.set_xy1(ref_left, lx, sl)
    line.set_xy2(ref_left, lx, sh)
    line.set_color(ref_left, col)
    line.set_width(ref_left, borderWidthInput)
    line.set_style(ref_left, lineStyle)
    line.set_xy1(ref_right, rx, sl)
    line.set_xy2(ref_right, rx, sh)
    line.set_color(ref_right, col)
    line.set_width(ref_right, borderWidthInput)
    line.set_style(ref_right, lineStyle)

f_manage_single_stdv_line(line_ref, x1, y1, x2, y2, color, style, width, should_draw, should_extend) =>
    line_id = line_ref
    if should_draw
        if na(line_id)
            line_id := line.new(x1, y1, x2, y2, color=color, style=style, width=width, extend=should_extend ? extend.right : extend.none)
        else
            line.set_xy1(line_id, x1, y1)
            line.set_xy2(line_id, x2, y2)
            line.set_color(line_id, color)
            line.set_style(line_id, style)
            line.set_width(line_id, width)
            line.set_extend(line_id, should_extend ? extend.right : extend.none)
    else if not na(line_id)
        line.delete(line_id)
        line_id := na
    line_id

f_manage_single_stdv_label(label_ref, x, y, labelText, textcolor, size, should_draw) =>
    label_id = label_ref
    if should_draw
        if na(label_id)
            label_id := label.new(x, y, labelText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=textcolor, color=na, size=size)
        else
            label.set_xy(label_id, x, y)
            label.set_text(label_id, labelText)
            label.set_textcolor(label_id, textcolor)
            label.set_size(label_id, size)
    else if not na(label_id)
        label.delete(label_id)
        label_id := na
    label_id

f_manage_stdv_lines(session_obj, show_overall, box_high, box_low, box_left, box_right) =>
    if stdv_type == "-6 to +6"
        mid_price = show_overall and not na(box_high) and not na(box_low) ? (box_high + box_low) / 2 : na
        one_stdv  = show_overall and not na(box_high) and not na(box_low) ? box_high - mid_price : na

        for i = 0 to array.size(ALL_STDV_LEVELS) - 1
            is_visible_level = array.get(stdv_show_config, i)
            level_val = array.get(ALL_STDV_LEVELS, i)
            level_color = array.get(stdv_color_config, i)
            level_style = f_get_line_style(array.get(stdv_style_config, i))
            should_extend = array.get(stdv_extend_config, i)
            price_level = not na(mid_price) ? mid_price + one_stdv * level_val : na
            
            current_line_ref = array.get(session_obj.stdv_lines, i)
            should_draw_this_line = show_overall and not na(box_high) and not na(box_low) and is_visible_level and not na(price_level)
            updated_line_ref = f_manage_single_stdv_line(current_line_ref, box_left, price_level, box_right, price_level, level_color, level_style, stdv_line_width, should_draw_this_line, should_extend)
            array.set(session_obj.stdv_lines, i, updated_line_ref)
            
            current_label_ref = array.get(session_obj.stdv_labels, i)
            should_draw_label = should_draw_this_line and stdv_label_pos != "None"
            label_x = switch stdv_label_pos
                "Left"   => box_left
                "Center" => int((box_left + box_right) / 2)
                "Right"  => box_right
            stdv_label_text = str.tostring(level_val)
            updated_label_ref = f_manage_single_stdv_label(current_label_ref, label_x, price_level, stdv_label_text, level_color, stdvLabelSize, should_draw_label)
            array.set(session_obj.stdv_labels, i, updated_label_ref)
    else // For "-3 to +3"
        range_height = show_overall and not na(box_high) and not na(box_low) ? box_high - box_low : na
        if show_overall and not na(range_height) and range_height > 0
            label_x = switch stdv_label_pos
                "Left"   => box_left
                "Center" => int((box_left + box_right) / 2)
                "Right"  => box_right

            // Draw 0 levels
            updated_line_ref_high = f_manage_single_stdv_line(array.get(session_obj.stdv_lines, 17), box_left, box_high, box_right, box_high, color_pos_8, f_get_line_style("Solid"), stdv_line_width, true, false)
            array.set(session_obj.stdv_lines, 17, updated_line_ref_high)
            updated_label_ref_high = f_manage_single_stdv_label(array.get(session_obj.stdv_labels, 17), label_x, box_high, "0", color_pos_8, stdvLabelSize, stdv_label_pos != "None")
            array.set(session_obj.stdv_labels, 17, updated_label_ref_high)

            updated_line_ref_low = f_manage_single_stdv_line(array.get(session_obj.stdv_lines, 18), box_left, box_low, box_right, box_low, color_neg_8, f_get_line_style("Solid"), stdv_line_width, true, false)
            array.set(session_obj.stdv_lines, 18, updated_line_ref_low)
            updated_label_ref_low = f_manage_single_stdv_label(array.get(session_obj.stdv_labels, 18), label_x, box_low, "0", color_neg_8, stdvLabelSize, stdv_label_pos != "None")
            array.set(session_obj.stdv_labels, 18, updated_label_ref_low)

            // Part A: external levels
            ext_levels = array.from(0.5, 1.0, 1.5, 2.0, 2.5, 3.0)
            ext_level_colors = array.from(color_pos_1, color_pos_2, color_pos_3, color_pos_4, color_pos_5, color_pos_6)
            
            for i = 0 to array.size(ext_levels) - 1
                level_val = array.get(ext_levels, i)
                level_color = array.get(ext_level_colors, i)

                // Positive levels
                price_level_pos = box_high + level_val * range_height
                updated_line_ref_pos = f_manage_single_stdv_line(array.get(session_obj.stdv_lines, i), box_left, price_level_pos, box_right, price_level_pos, level_color, f_get_line_style("Solid"), stdv_line_width, true, false)
                array.set(session_obj.stdv_lines, i, updated_line_ref_pos)
                
                updated_label_ref_pos = f_manage_single_stdv_label(array.get(session_obj.stdv_labels, i), label_x, price_level_pos, "+" + str.tostring(level_val), level_color, stdvLabelSize, stdv_label_pos != "None")
                array.set(session_obj.stdv_labels, i, updated_label_ref_pos)

                // Negative levels
                price_level_neg = box_low - level_val * range_height
                updated_line_ref_neg = f_manage_single_stdv_line(array.get(session_obj.stdv_lines, i + 6), box_left, price_level_neg, box_right, price_level_neg, level_color, f_get_line_style("Solid"), stdv_line_width, true, false)
                array.set(session_obj.stdv_lines, i + 6, updated_line_ref_neg)

                updated_label_ref_neg = f_manage_single_stdv_label(array.get(session_obj.stdv_labels, i + 6), label_x, price_level_neg, "-" + str.tostring(level_val), level_color, stdvLabelSize, stdv_label_pos != "None")
                array.set(session_obj.stdv_labels, i + 6, updated_label_ref_neg)

            // Part B: internal levels
            int_levels = array.from(0.21, 0.38, 0.5, 0.62, 0.79)
            int_level_colors = array.from(color_mid_0_0, color_mid_0_0, color.new(#31bf0e, 21), color_mid_0_0, color_mid_0_0)
            for i = 0 to array.size(int_levels) - 1
                level_val = array.get(int_levels, i)
                level_color = array.get(int_level_colors, i)
                price_level = box_low + level_val * range_height
                updated_line_ref = f_manage_single_stdv_line(array.get(session_obj.stdv_lines, i + 12), box_left, price_level, box_right, price_level, level_color, f_get_line_style("Solid"), stdv_line_width, true, false)
                array.set(session_obj.stdv_lines, i + 12, updated_line_ref)

                updated_label_ref = f_manage_single_stdv_label(array.get(session_obj.stdv_labels, i + 12), label_x, price_level, str.tostring(level_val), level_color, stdvLabelSize, stdv_label_pos != "None")
                array.set(session_obj.stdv_labels, i + 12, updated_label_ref)
            
            // Clean up unused lines/labels from the old mode
            for i = 19 to 24
                updated_line_ref = f_manage_single_stdv_line(array.get(session_obj.stdv_lines, i), 0, 0, 0, 0, color.black, f_get_line_style("Solid"), 0, false, false)
                array.set(session_obj.stdv_lines, i, updated_line_ref)
                updated_label_ref = f_manage_single_stdv_label(array.get(session_obj.stdv_labels, i), 0, 0, "", color.black, size.tiny, false)
                array.set(session_obj.stdv_labels, i, updated_label_ref)
        else
            // Not visible, delete all lines
            for i = 0 to 24
                updated_line_ref = f_manage_single_stdv_line(array.get(session_obj.stdv_lines, i), 0, 0, 0, 0, color.black, f_get_line_style("Solid"), 0, false, false)
                array.set(session_obj.stdv_lines, i, updated_line_ref)
                updated_label_ref = f_manage_single_stdv_label(array.get(session_obj.stdv_labels, i), 0, 0, "", color.black, size.tiny, false)
                array.set(session_obj.stdv_labels, i, updated_label_ref)

f_delete_session(session_obj) =>
    if isBoxesMode and not na(session_obj.box_obj)
        box.delete(session_obj.box_obj)
    else
        if not na(session_obj.line_left)
            line.delete(session_obj.line_left)
        if not na(session_obj.line_right)
            line.delete(session_obj.line_right)
        if not na(session_obj.line_top)
            line.delete(session_obj.line_top)
    if not na(session_obj.label_obj)
        label.delete(session_obj.label_obj)
    if not na(session_obj.pr50_line_obj)
        line.delete(session_obj.pr50_line_obj)
    f_manage_stdv_lines(session_obj, false, 0, 0, 0, 0)
    for j = array.size(activeLabels) - 1 to 0
        if array.get(activeLabels, j).id == session_obj.id
            array.remove(activeLabels, j)
            break

manage_fractal_component(string component_type, array<Session> session_array, bool show, bool is_visible, string labelText, color borderColor, color bgColor, int sessionStart, int sessionEnd, bool showSeconds, bool show50PR, bool showStdv, int fractalKey, int maxLookback, bool useLookback, int lookbackCount) =>
    if useLookback and array.size(session_array) > lookbackCount
        s_to_del = array.shift(session_array)
        f_delete_session(s_to_del)

    tf_ms = timeframe.in_seconds(timeframe.period) * 1000
    bs = not na(sessionStart) and time >= sessionStart ? int(math.round((time - sessionStart) / tf_ms)) : 0
    bars_since_start = math.max(0, bs)
    bars_to_lookback = math.min(bars_since_start, maxLookback)
    window_len = int(math.max(1, math.min(bars_to_lookback + 1, maxLookback + 1)))
    safe_window_len = math.min(window_len, bar_index + 1)
    initial_high = ta.highest(high, safe_window_len)
    initial_low = ta.lowest(low, safe_window_len)

    if not na(sessionStart) and not na(sessionEnd)

        final_border_color = show and is_visible ? borderColor : na
        final_bg_color = show and is_visible ? bgColor : na
        final_text_color = show and is_visible ? borderColor : na

        textToShow = labelText + " " + component_type
        if labelContentInput == "Fractal Time Info"
            sH = f_format_2(hour(sessionStart, tzInput)), sM = f_format_2(minute(sessionStart, tzInput))
            eH = f_format_2(hour(sessionEnd,   tzInput)), eM = f_format_2(minute(sessionEnd,   tzInput))
            if showSeconds
                sS = f_format_2(second(sessionStart, tzInput)), eS = f_format_2(second(sessionEnd,   tzInput))
                textToShow := sH + ":" + sM + ":" + sS + " - " + eH + ":" + eM + ":" + eS + " (" + component_type + ")"
            else
                textToShow := sH + ":" + sM + " - " + eH + ":" + eM + " (" + component_type + ")"
        else if labelContentInput == "No info"
            textToShow := ""
        
        final_label_text = is_visible ? textToShow : ""

        inSession = time >= sessionStart and time < sessionEnd
        sid = sessionStart + fractalKey

        found = Session.new()
        isFound = false
        for s in session_array
            if s.id == sid
                found := s
                isFound := true
                break
    
        if inSession and not isFound and show
            start_bar = bar_index - bars_to_lookback
            bars_to_end = tf_ms > 0 ? int(math.floor((sessionEnd - time) / tf_ms)) : 0
            end_bar = bar_index + math.min(bars_to_end, 499)
            sh = initial_high, sl = initial_low
            if not na(sh) and not na(sl)
                box b = na
                line ln_left = na, line ln_right = na, line ln_top = na
                if isBoxesMode
                    b := box.new(start_bar, sh, end_bar, sl, border_color=final_border_color, border_width=borderWidthInput, bgcolor=final_bg_color)
                else
                    [l, r, t] = f_create_outline_lines(start_bar, end_bar, sh, sl, final_border_color, line.style_solid)
                    ln_left := l, ln_right := r, ln_top := t
                mid_x = int(math.round((start_bar + end_bar) / 2))
                label la = label.new(mid_x, sh, final_label_text, yloc=yloc.price, style=label.style_label_down, textcolor=final_text_color, color=na, size=fractalLabelSize)
                array.push(activeLabels, LabelInfo.new(sid, la, start_bar, end_bar, sh))
                line pr50Line = na
                if show50PR
                    pr50 = (sh + sl) / 2
                    pr50Line := line.new(start_bar, pr50, end_bar, pr50, color=final_border_color, style=line.style_solid, width=lineWidth50pr)

                newSession = Session.new(sid, b, la, ln_left, ln_right, ln_top, sh, sl, pr50Line, array.new<line>(25, na), array.new<label>(25, na))
                f_manage_stdv_lines(newSession, showStdv and is_visible, sh, sl, start_bar, end_bar)
                array.push(session_array, newSession)

        else if isFound and inSession
            box_left = isBoxesMode ? box.get_left(found.box_obj) : (na(found.line_left) ? (bar_index - bars_to_lookback) : int(line.get_x1(found.line_left)))
            bars_to_end = tf_ms > 0 ? int(math.floor((sessionEnd - time) / tf_ms)) : 0
            box_right = bar_index + math.min(bars_to_end, 499)
            sh = math.max(found.session_high, high), sl = math.min(found.session_low, low)
            if not na(sh) and not na(sl)
                found.session_high := sh, found.session_low := sl
                if isBoxesMode
                    box.set_top(found.box_obj, sh), box.set_bottom(found.box_obj, sl), box.set_right(found.box_obj, box_right), box.set_bgcolor(found.box_obj, final_bg_color), box.set_border_color(found.box_obj, final_border_color)
                else
                    if na(found.line_right)
                        [l, r, t] = f_create_outline_lines(box_left, box_right, sh, sl, final_border_color, line.style_solid)
                        found.line_left := l, found.line_right := r, found.line_top := t
                    else
                        line.set_x1(found.line_right, box_right), line.set_x2(found.line_right, box_right)
                        f_update_outline_lines(found.line_left, found.line_right, sh, sl, final_border_color, line.style_solid)
                        lx = int(line.get_x1(found.line_left))
                        line.set_xy1(found.line_top, lx, sh), line.set_xy2(found.line_top, box_right, sh)
                        line.set_color(found.line_top, final_border_color), line.set_width(found.line_top, borderWidthInput)
                mid_x = int(math.round((box_left + box_right) / 2))
                label.set_text(found.label_obj, final_label_text), label.set_x(found.label_obj, mid_x), label.set_textcolor(found.label_obj, final_text_color), label.set_size(found.label_obj, fractalLabelSize)
                target_y = sh
                if preventOverlapInput and is_visible
                    y_offset = ta.tr * 1.5
                    is_safe = false
                    while not is_safe
                        is_safe := true
                        for item in activeLabels
                            if item.id != sid and item.x2 >= box_left and item.x1 <= box_right and math.abs(target_y - item.y) < y_offset
                                target_y := item.y + y_offset, is_safe := false
                                break
                label.set_y(found.label_obj, target_y)
                for item in activeLabels
                    if item.id == sid
                        item.x2 := box_right, item.y  := target_y
                        break
                if show50PR
                    pr50 = (sh + sl) / 2
                    if na(found.pr50_line_obj)
                        found.pr50_line_obj := line.new(box_left, pr50, box_right, pr50, color=final_border_color, style=line.style_solid, width=lineWidth50pr)
                    else
                        line.set_xy1(found.pr50_line_obj, box_left,  pr50), line.set_xy2(found.pr50_line_obj, box_right, pr50), line.set_color(found.pr50_line_obj, final_border_color)
                else if not na(found.pr50_line_obj)
                    line.delete(found.pr50_line_obj)
                    found.pr50_line_obj := na
                f_manage_stdv_lines(found, showStdv and is_visible, sh, sl, box_left, box_right)
        else if isFound and not inSession
            if not is_visible
                if isBoxesMode
                    box.set_border_color(found.box_obj, na), box.set_bgcolor(found.box_obj, na)
                else
                    line.set_color(found.line_left, na), line.set_color(found.line_right, na), line.set_color(found.line_top, na)
                label.set_text(found.label_obj, "")
                if not na(found.pr50_line_obj)
                    line.set_color(found.pr50_line_obj, na)
                f_manage_stdv_lines(found, false, 0,0,0,0)

manage_future_fractal_component(string component_type, bool show, string labelText, color borderColor, color bgColor, int sessionStart, int sessionEnd, bool showSeconds, int fractalKey) =>
    var futureSessions = array.new<Session>()
    
    if not na(sessionStart) and not na(sessionEnd) and show
        textToShow = labelText + " " + component_type + " (Next)"
        if labelContentInput == "Fractal Time Info"
            sH = f_format_2(hour(sessionStart, tzInput)), sM = f_format_2(minute(sessionStart, tzInput))
            eH = f_format_2(hour(sessionEnd,   tzInput)), eM = f_format_2(minute(sessionEnd,   tzInput))
            if showSeconds
                sS = f_format_2(second(sessionStart, tzInput)), eS = f_format_2(second(sessionEnd,   tzInput))
                textToShow := sH + ":" + sM + ":" + sS + " - " + eH + ":" + eM + ":" + eS + " (Next)"
            else
                textToShow := sH + ":" + sM + " - " + eH + ":" + eM + " (Next)"
        else if labelContentInput == "No info"
            textToShow := ""

        sid = sessionStart + fractalKey + 2000

        chart_tf_ms = timeframe.in_seconds(timeframe.period) * 1000
        time_to_start = sessionStart - time
        time_to_end = sessionEnd - time
        bars_to_start = chart_tf_ms > 0 and time_to_start > 0 ? int(math.floor(time_to_start / chart_tf_ms)) : 0
        bars_to_end = chart_tf_ms > 0 and time_to_end > 0 ? int(math.floor(time_to_end / chart_tf_ms)) : 1
        start_bar = bar_index + bars_to_start
        end_bar = bar_index + math.min(bars_to_end, 499)
        sh = high, sl = low

        isFound = false
        for s in futureSessions
            if s.id == sid
                isFound := true
                break

        if not isFound
            futureBorderColor = color.new(borderColor, 70)
            futureBgColor = color.new(bgColor, 90)
            box b = na, line ln_left = na, line ln_right = na, line ln_top = na
            if isBoxesMode
                b := box.new(start_bar, sh, end_bar, sl, border_color=futureBorderColor, border_width=borderWidthInput, bgcolor=futureBgColor)
            else
                [l, r, t] = f_create_outline_lines(start_bar, end_bar, sh, sl, futureBorderColor, line.style_dashed)
                ln_left := l, ln_right := r, ln_top := t
            mid_x = int(math.round((start_bar + end_bar) / 2))
            label la = label.new(mid_x, sh, textToShow, yloc=yloc.price, style=label.style_label_down, textcolor=futureBorderColor, color=na, size=fractalLabelSize)
            array.push(futureSessions, Session.new(sid, b, la, ln_left, ln_right, ln_top, sh, sl, na, array.new<line>(25, na), array.new<label>(25, na)))

    if array.size(futureSessions) > 0
        for i = array.size(futureSessions) - 1 to 0
            s = array.get(futureSessions, i)
            left_bar = isBoxesMode ? box.get_left(s.box_obj) : (na(s.line_left) ? na : int(line.get_x1(s.line_left)))
            if not na(left_bar) and left_bar < bar_index - 10
                f_delete_session(s)
                array.remove(futureSessions, i)

f_manage_vdivs(show, start_time, color, style, width, array<line> line_array, useLookback, lookbackCount) =>
    is_new_session_bar = not na(start_time) and time >= start_time and time[1] < start_time

    if show and is_new_session_bar
        array.push(line_array, line.new(x1=bar_index, y1=low, x2=bar_index, y2=high, extend=extend.both, color=color, style=f_get_line_style(style), width=width))

    if useLookback
        while array.size(line_array) > lookbackCount
            line.delete(array.shift(line_array))

    if array.size(line_array) > 0
        for i = array.size(line_array) - 1 to 0
            l = array.get(line_array, i)
            if not show
                line.delete(array.remove(line_array, i))
            else
                line.set_color(l, color)
                line.set_style(l, f_get_line_style(style))
                line.set_width(l, width)

f_manage_future_vdiv(show, future_start_time, color, style, width, array<line> future_line_array) =>
    line_id = array.size(future_line_array) > 0 ? array.get(future_line_array, 0) : na

    if show and not na(future_start_time)
        chart_tf_ms = timeframe.in_seconds(timeframe.period) * 1000
        time_to_start = future_start_time - time
        bars_to_start = chart_tf_ms > 0 and time_to_start > 0 ? int(math.floor(time_to_start / chart_tf_ms)) : 0
        start_bar = bar_index + bars_to_start

        if na(line_id)
            l = line.new(start_bar, low, start_bar, high, extend=extend.both, color=color, style=f_get_line_style(style), width=width)
            array.push(future_line_array, l)
        else
            if line.get_x1(line_id) != start_bar
                line.set_x1(line_id, start_bar)
                line.set_x2(line_id, start_bar)
            
            line.set_color(line_id, color)
            line.set_style(line_id, f_get_line_style(style))
            line.set_width(line_id, width)

        if not na(line_id) and line.get_x1(line_id) < bar_index
            line.delete(array.remove(future_line_array, 0))

    else if not na(line_id)
        line.delete(array.remove(future_line_array, 0))

f_manage_candle_open_vdivs(string tf, bool show, bool show_label, color vcolor, int lookback, array<line> past_lines, array<line> future_lines, array<label> past_labels, array<label> future_labels, string label_pos, string label_size, string label_color_src, color custom_label_color, bool show_year, bool show_month, bool show_day, bool show_time) =>
    label_style = label_pos == "Top" ? label.style_label_up : label_pos == "Bottom" ? label.style_label_down : label.style_none
    final_label_color = label_color_src == "Custom" ? custom_label_color : vcolor

    format_str = ""
    if show_year
        format_str := format_str + "yyyy"
    if show_month
        format_str := format_str + (format_str == "" ? "" : " ") + "MMM"
    if show_day
        format_str := format_str + (format_str == "" ? "" : " ") + "E"
    if show_time
        format_str := format_str + (format_str == "" ? "" : " ") + "HH:mm"

    visible_high = ta.highest(high, lookback)
    visible_low  = ta.lowest(low, lookback)
    price_range = na(visible_high) or na(visible_low) ? ta.tr : visible_high - visible_low

    float label_y_pos = switch label_pos
        "Top"    => visible_high + price_range * 0.05
        "Bottom" => visible_low - price_range * 0.05
        => (visible_high + visible_low) / 2

    is_new_tf_bar = na(time(tf)[1]) or time(tf) != time(tf)[1]
    if show and is_new_tf_bar
        array.push(past_lines, line.new(bar_index, low, bar_index, high, color=vcolor, style=line.style_solid, width=1, extend=extend.both))
        if show_label and format_str != ""
            time_text = str.format("{0,time," + format_str + "}", time(tf))
            array.push(past_labels, label.new(bar_index, label_y_pos, time_text, yloc=yloc.price, style=label_style, textalign=text.align_center, color=color.new(vcolor, 100), textcolor=final_label_color, size=label_size))

    if array.size(past_lines) > 0
        for i = array.size(past_lines) - 1 to 0
            l = array.get(past_lines, i)
            if not show or (bar_index - line.get_x1(l) > lookback)
                line.delete(array.remove(past_lines, i))
            else
                line.set_color(l, vcolor)

    if array.size(past_labels) > 0
        for i = array.size(past_labels) - 1 to 0
            la = array.get(past_labels, i)
            if not show or not show_label or (bar_index - label.get_x(la) > lookback) or format_str == ""
                label.delete(array.remove(past_labels, i))
            else
                label.set_y(la, label_y_pos)
                label.set_textcolor(la, final_label_color)
                label.set_color(la, color.new(vcolor, 100))
                label.set_style(la, label_style)
                label.set_size(la, label_size)

    if array.size(future_lines) > 0
        for i = array.size(future_lines) - 1 to 0
            l = array.get(future_lines, i)
            if not na(l) and line.get_x1(l) < bar_index
                line.delete(array.remove(future_lines, i))
    if array.size(future_labels) > 0
        for i = array.size(future_labels) - 1 to 0
            la = array.get(future_labels, i)
            if not na(la) and label.get_x(la) < bar_index
                label.delete(array.remove(future_labels, i))

    if show and is_new_tf_bar
        tf_ms = timeframe.in_seconds(tf) * 1000
        chart_tf_ms = timeframe.in_seconds(timeframe.period) * 1000
        if tf_ms > 0 and chart_tf_ms > 0
            for l in future_lines
                if not na(l)
                    line.delete(l)
            array.clear(future_lines)
            if show_label
                for la in future_labels
                    if not na(la)
                        label.delete(la)
                array.clear(future_labels)

            for j = 1 to 2
                future_start_time = time(tf) + j * tf_ms
                time_to_start = future_start_time - time
                bars_to_start = int(math.round(time_to_start / chart_tf_ms))
                start_bar = bar_index + bars_to_start
                array.push(future_lines, line.new(start_bar, low, start_bar, high, color=vcolor, style=line.style_dashed, width=1, extend=extend.both))
                if show_label and format_str != ""
                    time_text = str.format("{0,time," + format_str + "}", future_start_time)
                    array.push(future_labels, label.new(start_bar, label_y_pos, time_text, yloc=yloc.price, style=label_style, textalign=text.align_center, color=color.new(vcolor, 100), textcolor=final_label_color, size=label_size))

f_get_session_times_for_asset(assetName, y, m, d, dow, t) =>
    cycle_anchor_h = assetName == "Forex" ? 17 : assetName == "Gold&Futures" ? 18 : 20
    cycle_anchor_m = 0
    anchor_dow = assetName == "Crypto" ? dayofweek.sunday : dayofweek.monday
    
    y1Start  = f_find_yearly_anchor(cycle_anchor_h, cycle_anchor_m, y, t)
    m3Start  = f_find_quarterly_anchor(cycle_anchor_h, cycle_anchor_m, y, m, t)
    m1Start  = f_find_monthly_anchor(cycle_anchor_h, cycle_anchor_m, y, m, t)
    w1Start  = f_find_weekly_anchor(anchor_dow, cycle_anchor_h, cycle_anchor_m, dow, t)

    d1Start  = f_find_last_cycle_anchor(24 * MS_IN_HOUR, cycle_anchor_h, cycle_anchor_m, y, m, d, t)
    h4Start  = f_find_last_cycle_anchor(4 * MS_IN_HOUR, cycle_anchor_h, cycle_anchor_m, y, m, d, t)
    [h1Start, _] = f_get_cyclical_fractal('60', 0, 0)
    [m15Start, _] = f_get_cyclical_fractal('15', 0, 0)
    [m5Start, _] = f_get_cyclical_fractal('5', 0, 0)
    
    [m5Start, m15Start, h1Start, h4Start, d1Start, w1Start, m1Start, m3Start, y1Start]


f_get_future_session_times_for_asset(assetName, y, m, d, dow, t) =>
    [m5Now, m15Now, h1Now, h4Now, d1Now, w1Now, m1Now, m3Now, y1Now] = f_get_session_times_for_asset(assetName, y, m, d, dow, t)

    y_of_y1 = year(y1Now, tzInput)
    y1_dur = timestamp(tzInput, y_of_y1 + 1, month(y1Now, tzInput), dayofmonth(y1Now, tzInput), hour(y1Now, tzInput), minute(y1Now, tzInput), 0) - y1Now
    y1Start = y1Now + y1_dur
    
    y_of_m3 = year(m3Now, tzInput)
    m_of_m3 = month(m3Now, tzInput)
    next_m3_y = m_of_m3 >= 10 ? y_of_m3 + 1 : y_of_m3
    next_m3_m = m_of_m3 >= 10 ? (m_of_m3 + 3) % 12 : m_of_m3 + 3
    m3_dur = timestamp(tzInput, next_m3_y, next_m3_m, dayofmonth(m3Now, tzInput), hour(m3Now, tzInput), minute(m3Now, tzInput), 0) - m3Now
    m3Start = m3Now + m3_dur

    y_of_m1 = year(m1Now, tzInput)
    m_of_m1 = month(m1Now, tzInput)
    next_m1_y = m_of_m1 == 12 ? y_of_m1 + 1 : y_of_m1
    next_m1_m = m_of_m1 == 12 ? 1 : m_of_m1 + 1
    m1_dur = timestamp(tzInput, next_m1_y, next_m1_m, dayofmonth(m1Now, tzInput), hour(m1Now, tzInput), minute(m1Now, tzInput), 0) - m1Now
    m1Start = m1Now + m1_dur

    w1Start = w1Now + MS_IN_WEEK
    d1Start = d1Now + MS_IN_DAY
    h4Start = h4Now + 4 * MS_IN_HOUR
    h1Start = h1Now + MS_IN_HOUR
    m15Start = m15Now + 15 * MS_IN_MIN
    m5Start = m5Now + 5 * MS_IN_MIN
    
    [m5Start, m15Start, h1Start, h4Start, d1Start, w1Start, m1Start, m3Start, y1Start]

var m5_or_sessions = array.new<Session>(), var m5_nest_sessions = array.new<Session>(), var m5_of_sessions = array.new<Session>(), var m5_ffd_sessions = array.new<Session>(), var m5_vdivs = array.new<line>(), var m5_future_vdivs = array.new<line>()
var m15_or_sessions = array.new<Session>(), var m15_nest_sessions = array.new<Session>(), var m15_of_sessions = array.new<Session>(), var m15_ffd_sessions = array.new<Session>(), var m15_vdivs = array.new<line>(), var m15_future_vdivs = array.new<line>()
var h1_or_sessions = array.new<Session>(), var h1_nest_sessions = array.new<Session>(), var h1_of_sessions = array.new<Session>(), var h1_ffd_sessions = array.new<Session>(), var h1_vdivs = array.new<line>(), var h1_future_vdivs = array.new<line>()
