string COMPONENT_OR = "OR"
string COMPONENT_NEST = "Nest"
string COMPONENT_OF = "OF"
string COMPONENT_FFD = "FFD"

PERF_MAX_LOOKBACK = 500

MS_IN_HOUR = 3600000, MS_IN_MIN  = 60000, MS_IN_SEC  = 1000, MS_IN_DAY  = 24 * MS_IN_HOUR, MS_IN_WEEK = 7  * MS_IN_DAY

type Session
    int id
    box box_obj
    label label_obj
    line line_left
    line line_right
    line line_top
    float session_high
    float session_low
    line pr50_line_obj
    array<line> stdv_lines
    array<label> stdv_labels

type LabelInfo
    int id
    label label_obj
    int x1
    int x2
    float y

f_get_timeframe_seconds(tf_string) =>
    switch tf_string
        "1m"  => 60
        "5m"  => 300
        "15m" => 900
        "30m" => 1800
        "1H"  => 3600
        "4H"  => 14400
        "D"  => 86400
        "1W"  => 604800
        => na

f_should_show_fractal(enableFilter, maxTf) =>
    not enableFilter or timeframe.in_seconds(timeframe.period) <= f_get_timeframe_seconds(maxTf)

f_format_2(n) => n < 10 ? "0" + str.tostring(n) : str.tostring(n)
f_get_line_style(style) => style == "Solid" ? line.style_solid : style == "Dashed" ? line.style_dashed : line.style_dotted

f_auto_detect_asset() =>
    asset = if syminfo.type == "forex"
        "Forex"
    else if syminfo.type == "crypto"
        "Crypto"
    else if syminfo.type == "futures" or str.contains(str.upper(syminfo.ticker), "XAU")
        "Gold&Futures"
    else
        "Forex"
    asset

f_find_daily_yearly_anchor(daily_anchor_h, daily_anchor_m, y, t) =>
    year_anchor = timestamp(tzInput, y, 1, 1, daily_anchor_h, daily_anchor_m, 0)
    year_anchor > t ? timestamp(tzInput, y - 1, 1, 1, daily_anchor_h, daily_anchor_m, 0) : year_anchor

f_find_daily_quarterly_anchor(daily_anchor_h, daily_anchor_m, y, m, t) =>
    q_start_month = m <= 3 ? 1 : m <= 6 ? 4 : m <= 9 ? 7 : 10
    quarter_anchor = timestamp(tzInput, y, q_start_month, 1, daily_anchor_h, daily_anchor_m, 0)
    if quarter_anchor > t
        prev_q_start_y = q_start_month <= 3 ? y - 1 : y
        prev_q_start_m = q_start_month <= 3 ? q_start_month + 9 : q_start_month - 3
        timestamp(tzInput, prev_q_start_y, prev_q_start_m, 1, daily_anchor_h, daily_anchor_m, 0)
    else
        quarter_anchor

f_find_daily_monthly_anchor(daily_anchor_h, daily_anchor_m, y, m, t) =>
    month_anchor = timestamp(tzInput, y, m, 1, daily_anchor_h, daily_anchor_m, 0)
    if month_anchor > t
        prev_m = m == 1 ? 12 : m - 1
        prev_y = m == 1 ? y - 1 : y
        timestamp(tzInput, prev_y, prev_m, 1, daily_anchor_h, daily_anchor_m, 0)
    else
        month_anchor

f_find_daily_weekly_anchor(daily_anchor_h, daily_anchor_m, dow, t) =>
    days_to_subtract = (dow - dayofweek.monday + 7) % 7
    current_day_start_t = timestamp(tzInput, year(t, tzInput), month(t, tzInput), dayofmonth(t, tzInput), 0, 0, 0)
    anchor_day_start_t = current_day_start_t - days_to_subtract * MS_IN_DAY
    session_anchor_t = anchor_day_start_t + daily_anchor_h * MS_IN_HOUR + daily_anchor_m * MS_IN_MIN
    session_anchor_t > t ? session_anchor_t - MS_IN_WEEK : session_anchor_t

f_find_yearly_anchor(cycle_anchor_h, cycle_anchor_m, y, t) =>
    year_anchor = timestamp(tzInput, y, 1, 1, cycle_anchor_h, cycle_anchor_m, 0)
    year_anchor > t ? timestamp(tzInput, y - 1, 1, 1, cycle_anchor_h, cycle_anchor_m, 0) : year_anchor

f_find_quarterly_anchor(cycle_anchor_h, cycle_anchor_m, y, m, t) =>
    q_start_month = m <= 3 ? 1 : m <= 6 ? 4 : m <= 9 ? 7 : 10
    quarter_anchor = timestamp(tzInput, y, q_start_month, 1, cycle_anchor_h, cycle_anchor_m, 0)
    if quarter_anchor > t
        prev_q_start_y = q_start_month <= 3 ? y - 1 : y
        prev_q_start_m = q_start_month <= 3 ? q_start_month + 9 : q_start_month - 3
        timestamp(tzInput, prev_q_start_y, prev_q_start_m, 1, cycle_anchor_h, cycle_anchor_m, 0)
    else
        quarter_anchor

f_find_monthly_anchor(cycle_anchor_h, cycle_anchor_m, y, m, t) =>
    month_anchor = timestamp(tzInput, y, m, 1, cycle_anchor_h, cycle_anchor_m, 0)
    if month_anchor > t
        prev_m = m == 1 ? 12 : m - 1
        prev_y = m == 1 ? y - 1 : y
        timestamp(tzInput, prev_y, prev_m, 1, cycle_anchor_h, cycle_anchor_m, 0)
    else
        month_anchor

f_find_weekly_anchor(anchor_dow, cycle_anchor_h, cycle_anchor_m, dow, t) =>
    days_to_subtract = (dow - anchor_dow + 7) % 7
    current_day_start_t = timestamp(tzInput, year(t, tzInput), month(t, tzInput), dayofmonth(t, tzInput), 0, 0, 0)
    anchor_day_start_t = current_day_start_t - days_to_subtract * MS_IN_DAY
    session_anchor_t = anchor_day_start_t + cycle_anchor_h * MS_IN_HOUR + cycle_anchor_m * MS_IN_MIN
    session_anchor_t > t ? session_anchor_t - MS_IN_WEEK : session_anchor_t

f_find_last_cycle_anchor(cycle_ms, anchor_h, anchor_m, y, m, d, t) =>
    day_anchor = timestamp(tzInput, y, m, d, anchor_h, anchor_m, 0)
    base_anchor = t >= day_anchor ? day_anchor : day_anchor - MS_IN_DAY
    ms_since_base = t - base_anchor
    num_cycles = math.floor(ms_since_base / cycle_ms)
    base_anchor + num_cycles * cycle_ms

f_find_next_cycle_anchor(cycle_ms, anchor_h, anchor_m, y, m, d, t) => f_find_last_cycle_anchor(cycle_ms, anchor_h, anchor_m, y, m, d, t) + cycle_ms

f_get_cyclical_fractal(tf_str, offset_ms, duration_ms) =>
    anchor     = time(tf_str, syminfo.session, tzInput)
    start_time = anchor + offset_ms
    end_time   = start_time + duration_ms
    [start_time, end_time]

f_get_future_cyclical_fractal(tf_str, offset_ms, duration_ms) =>
    current_anchor = time(tf_str, syminfo.session, tzInput)
    tf_ms = timeframe.in_seconds(tf_str) * 1000
    next_anchor = current_anchor + tf_ms
    start_time = next_anchor + offset_ms
    end_time   = start_time + duration_ms
    [start_time, end_time]

f_manage_swing_high_lows(show, sizeL, sizeR) =>
    isPivotHigh = false
    isPivotLow = false
    if show
        pivHi = ta.pivothigh(high, sizeL, sizeR)
        pivLo = ta.pivotlow(low, sizeL, sizeR)
        isPivotHigh := not na(pivHi)
        isPivotLow := not na(pivLo)
    [isPivotHigh, isPivotLow]

