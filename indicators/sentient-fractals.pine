//@version=6
indicator("Sentient Fractals", "Fractals", overlay=true, max_bars_back=5000, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

group_general = "General Settings"
autoDetectAsset        = input.bool(true, "Auto-Detect Asset Class", group=group_general, tooltip="When checked, the script will try to automatically determine the asset class (Forex, Gold, Crypto) from the chart's symbol. Uncheck to use the manual dropdown below.")
assetClass             = input.string("Forex: 17:00", "Asset Class", options=["Forex: 17:00", "Gold&Futures: 18:00", "Crypto: 20:00"], group=group_general, tooltip="Select the asset class to determine session times.")
labelContentInput      = input.string("No info", "Label Content", options=["Fractal Label", "Fractal Time Info", "No info"], group=group_general)
fractalLabelSize = input.string(size.small, "Fractal Label Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=group_general)
preventOverlapInput    = input.bool(false, "Prevent Label Overlap", group=group_general)
lookbackInput          = input.int(2000, "Lookback Period (Candles)", minval=10, group=group_general, tooltip="Max bars to look back to calculate High/Low. Yearly/Monthly fractals use a fixed internal limit (4990 bars) to prevent errors.")
tzInput                = input.string("America/New_York", "Timezone", group=group_general)
borderWidthInput       = input.int(1, "Border Width", group=group_general, minval=1, maxval=5)
lineWidth50pr          = input.int(1, "50% Line Width", group=group_general, minval=1)
fractalRenderMode        = input.string("Boxes", "Fractal Render Mode", options=["Boxes","Lines"], group=group_general, tooltip="Choose how fractals are drawn: filled boxes or outline lines (start & end verticals plus a top line).")
isBoxesMode            = fractalRenderMode == "Boxes"

group_candle_openings = "Candle Openings"
lookbackCandleOpenings = input.int(200, "Lookback by bars", group=group_candle_openings, tooltip="How many bars back to draw the opening lines.")
showCandleOpenTime = input.bool(false, "Info", group=group_candle_openings, tooltip="Show time info for candle opening lines.")
show5mOpen   = input.bool(false, "5m", group=group_candle_openings, inline="co_line1")
show15mOpen  = input.bool(false, "15m", group=group_candle_openings, inline="co_line1")
show30mOpen  = input.bool(false, "30m", group=group_candle_openings, inline="co_line1")
show1hOpen   = input.bool(false, "1h", group=group_candle_openings, inline="co_line1")
show4hOpen   = input.bool(false, "4h", group=group_candle_openings, inline="co_line2")
showDailyOpen  = input.bool(false, "D", group=group_candle_openings, inline="co_line2")
showWeeklyOpen = input.bool(false, "W", group=group_candle_openings, inline="co_line2")
showMonthlyOpen = input.bool(false, "M", group=group_candle_openings, inline="co_line3")
show3MonthOpen = input.bool(false, "3M", group=group_candle_openings, inline="co_line3")
showYearlyOpen = input.bool(false, "Y", group=group_candle_openings, inline="co_line3")
co_label_pos = input.string("Bottom", "Position", options=["Top", "Center", "Bottom"], group=group_candle_openings)
co_label_size = input.string(size.small, "Size", options=[size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=group_candle_openings)
co_label_color_src = input.string("Custom", "Color Source", options=["Line Color", "Custom"], group=group_candle_openings)
co_label_custom_color = input.color(color.rgb(3, 5, 13), "Custom Color", group=group_candle_openings)
co_label_show_year = input.bool(true, "Show Year", group=group_candle_openings, inline="co_l_3")
co_label_show_month = input.bool(true, "Show Month", group=group_candle_openings, inline="co_l_3")
co_label_show_day = input.bool(true, "Show Day", group=group_candle_openings, inline="co_l_3")
co_label_show_time = input.bool(true, "Show Time", group=group_candle_openings, inline="co_l_3")

group_5min = "⏱️ 5-Minute (5m) Fractal Settings"
startDayOffset5m   = input.int(0, "OR Day Offset", group=group_5min, inline="m5_anchor_or")
startHourOffset5m  = input.int(0, "OR Hour Offset", group=group_5min, inline="m5_anchor_or")
startMinuteOffset5m= input.int(0, "OR Min Offset", group=group_5min, inline="m5_anchor_or")
endDayOffset5m     = input.int(0, "OF Day Offset", group=group_5min, inline="m5_anchor_of")
endHourOffset5m    = input.int(0, "OF Hour Offset", group=group_5min, inline="m5_anchor_of")
endMinuteOffset5m  = input.int(0, "OF Min Offset", group=group_5min, inline="m5_anchor_of")
show5mOpenFloat = input.bool(false, "5m OF", group=group_5min, inline="m5_of")
color5mOpenFloat = input.color(color.new(color.purple, 10), "", group=group_5min, inline="m5_of")
bgColor5mOpenFloat = input.color(color.new(color.purple, 92), "", group=group_5min, inline="m5_of")
show50PR5m = input.bool(true, "50% PR", group=group_5min, inline="m5_of")
showStdvOF5m = input.bool(true, "STDVs", group=group_5min, inline="m5_of")
showFuture5m_OF = input.bool(false, "Future", group=group_5min, inline="m5_of")
show5mOpenRange = input.bool(false, "5m OR", group=group_5min, inline="m5_or")
color5mOpenRange = input.color(color.new(color.purple, 20), "", group=group_5min, inline="m5_or")
bgColor5mOpenRange = input.color(color.new(color.purple, 94), "", group=group_5min, inline="m5_or")
show50PR5mOR = input.bool(true, "50% PR", group=group_5min, inline="m5_or")
showStdvOR5m = input.bool(false, "STDVs", group=group_5min, inline="m5_or")
showFuture5m_OR = input.bool(false, "Future", group=group_5min, inline="m5_or")
show5mNest = input.bool(false, "5m Nest", group=group_5min, inline="m5_nest")
color5mNest = input.color(color.new(color.gray, 70), "Border", group=group_5min, inline="m5_nest")
bgColor5mNest = input.color(color.new(color.gray, 94), "BG", group=group_5min, inline="m5_nest")
showFuture5m_Nest = input.bool(false, "Future", group=group_5min, inline="m5_nest")
show_future_vdiv_5m = input.bool(false, "Future", group=group_5min, inline="m5_div")
show_vdiv_5m = input.bool(false, "Show Divider", group=group_5min, inline="m5_div")
color_vdiv_5m = input.color(color.new(color.purple, 50), "", group=group_5min, inline="m5_div")
style_vdiv_5m = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=group_5min, inline="m5_div")
width_vdiv_5m = input.int(1, "", group=group_5min, inline="m5_div", minval=1)
show_stdv_ffd_5m = input.bool(false, "STDVs", group=group_5min, inline="m5_ffd")
show_ffd_5m = input.bool(false, "FFD Border", group=group_5min, inline="m5_ffd")
color_ffd_5m = input.color(color.new(color.purple, 80), "", group=group_5min, inline="m5_ffd")
bgColor_ffd_5m = input.color(color.new(color.purple, 95), "BG", group=group_5min, inline="m5_ffd")
orDurationPct5m = input.float(16.67, "OR Duration (%)", minval=0.01, maxval=49.99, step=0.1, group=group_5min, inline="m5_timing", tooltip="Duration of the Opening Range as a percentage of the total fractal time. The sum of OR and OF percentages cannot exceed 100%.")
ofDurationPct5m = input.float(16.67, "OF Duration (%)", minval=0.01, maxval=49.99, step=0.1, group=group_5min, inline="m5_timing", tooltip="Duration of the Opening Float as a percentage of the total fractal time.")
useLookback5m = input.bool(true, "Limit History", group=group_5min, inline="m5_lookback", tooltip="Enable to limit the number of past fractals shown.")
lookbackCount5m = input.int(2, "", group=group_5min, inline="m5_lookback", minval=1, tooltip="Number of fractals to show.")
enableTfVisibility5m = input.bool(false, "highest TF Visibility", group=group_5min, inline="m5_tf_vis")
maxTfVisibility5m = input.string("1m", "", options=["1m","5m","15m","30m","1H","4H","D","1W"], group=group_5min, inline="m5_tf_vis")

