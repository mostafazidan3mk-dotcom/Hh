var d1_or_sessions = array.new<Session>(), var d1_nest_sessions = array.new<Session>(), var d1_of_sessions = array.new<Session>(), var d1_ffd_sessions = array.new<Session>(), var d1_vdivs = array.new<line>(), var d1_future_vdivs = array.new<line>()
var w1_or_sessions = array.new<Session>(), var w1_nest_sessions = array.new<Session>(), var w1_of_sessions = array.new<Session>(), var w1_ffd_sessions = array.new<Session>(), var w1_vdivs = array.new<line>(), var w1_future_vdivs = array.new<line>()
var m1_or_sessions = array.new<Session>(), var m1_nest_sessions = array.new<Session>(), var m1_of_sessions = array.new<Session>(), var m1_ffd_sessions = array.new<Session>(), var m1_vdivs = array.new<line>(), var m1_future_vdivs = array.new<line>()
var m3_or_sessions = array.new<Session>(), var m3_nest_sessions = array.new<Session>(), var m3_of_sessions = array.new<Session>(), var m3_ffd_sessions = array.new<Session>(), var m3_vdivs = array.new<line>(), var m3_future_vdivs = array.new<line>()
var y_or_sessions = array.new<Session>(), var y_nest_sessions = array.new<Session>(), var y_of_sessions = array.new<Session>(), var y_ffd_sessions = array.new<Session>(), var y_vdivs = array.new<line>(), var y_future_vdivs = array.new<line>()

y = year(time, tzInput), mo = month(time, tzInput), d = dayofmonth(time, tzInput), dow = dayofweek(time, tzInput)
string effectiveAssetClass = autoDetectAsset ? f_auto_detect_asset() : array.get(str.split(assetClass, ":"), 0)

[baseM5Start, baseM15Start, baseH1Start, baseH4Start, baseD1Start, baseW1Start, baseM1Start, baseM3Start, baseY1Start] = f_get_session_times_for_asset(effectiveAssetClass, y, mo, d, dow, time)
[futureBaseM5Start, futureBaseM15Start, futureBaseH1Start, futureBaseH4Start, futureBaseD1Start, futureBaseW1Start, futureBaseM1Start, futureBaseM3Start, futureBaseY1Start] = f_get_future_session_times_for_asset(effectiveAssetClass, y, mo, d, dow, time)

start_off_ms_5m = startDayOffset5m * MS_IN_DAY + startHourOffset5m * MS_IN_HOUR + startMinuteOffset5m * MS_IN_MIN
end_off_ms_5m = endDayOffset5m * MS_IN_DAY + endHourOffset5m * MS_IN_HOUR + endMinuteOffset5m * MS_IN_MIN
start_off_ms_15m = startDayOffset15m * MS_IN_DAY + startHourOffset15m * MS_IN_HOUR + startMinuteOffset15m * MS_IN_MIN
end_off_ms_15m = endDayOffset15m * MS_IN_DAY + endHourOffset15m * MS_IN_HOUR + endMinuteOffset15m * MS_IN_MIN
start_off_ms_1h = startDayOffset1h * MS_IN_DAY + startHourOffset1h * MS_IN_HOUR + startMinuteOffset1h * MS_IN_MIN
end_off_ms_1h = endDayOffset1h * MS_IN_DAY + endHourOffset1h * MS_IN_HOUR + endMinuteOffset1h * MS_IN_MIN
start_off_ms_4h = startDayOffset4h * MS_IN_DAY + startHourOffset4h * MS_IN_HOUR + startMinuteOffset4h * MS_IN_MIN
end_off_ms_4h = endDayOffset4h * MS_IN_DAY + endHourOffset4h * MS_IN_HOUR + endMinuteOffset4h * MS_IN_MIN
start_off_ms_D = startDayOffsetD * MS_IN_DAY + startHourOffsetD * MS_IN_HOUR + startMinuteOffsetD * MS_IN_MIN
end_off_ms_D = endDayOffsetD * MS_IN_DAY + endHourOffsetD * MS_IN_HOUR + endMinuteOffsetD * MS_IN_MIN
start_off_ms_W = startDayOffsetW * MS_IN_DAY + startHourOffsetW * MS_IN_HOUR + startMinuteOffsetW * MS_IN_MIN
end_off_ms_W = endDayOffsetW * MS_IN_DAY + endHourOffsetW * MS_IN_HOUR + endMinuteOffsetW * MS_IN_MIN
start_off_ms_M = startDayOffsetM * MS_IN_DAY + startHourOffsetM * MS_IN_HOUR + startMinuteOffsetM * MS_IN_MIN
end_off_ms_M = endDayOffsetM * MS_IN_DAY + endHourOffsetM * MS_IN_HOUR + endMinuteOffsetM * MS_IN_MIN
start_off_ms_3M = startDayOffset3M * MS_IN_DAY + startHourOffset3M * MS_IN_HOUR + startMinuteOffset3M * MS_IN_MIN
end_off_ms_3M = endDayOffset3M * MS_IN_DAY + endHourOffset3M * MS_IN_HOUR + endMinuteOffset3M * MS_IN_MIN
start_off_ms_Y = startDayOffsetY * MS_IN_DAY + startHourOffsetY * MS_IN_HOUR + startMinuteOffsetY * MS_IN_MIN
end_off_ms_Y = endDayOffsetY * MS_IN_DAY + endHourOffsetY * MS_IN_HOUR + endMinuteOffsetY * MS_IN_MIN

m5Start = baseM5Start + start_off_ms_5m
m15Start = baseM15Start + start_off_ms_15m
h1Start = baseH1Start + start_off_ms_1h
h4Start = baseH4Start + start_off_ms_4h
d1Start = baseD1Start + start_off_ms_D
w1Start = baseW1Start + start_off_ms_W
m1Start = baseM1Start + start_off_ms_M
m3Start = baseM3Start + start_off_ms_3M
y1Start = baseY1Start + start_off_ms_Y

futureM5Start = futureBaseM5Start + start_off_ms_5m
futureM15Start = futureBaseM15Start + start_off_ms_15m
futureH1Start = futureBaseH1Start + start_off_ms_1h
futureH4Start = futureBaseH4Start + start_off_ms_4h
futureD1Start = futureBaseD1Start + start_off_ms_D
futureW1Start = futureBaseW1Start + start_off_ms_W
futureM1Start = futureBaseM1Start + start_off_ms_M
futureM3Start = futureBaseM3Start + start_off_ms_3M
futureY1Start = futureBaseY1Start + start_off_ms_Y

is_visible_5m = f_should_show_fractal(enableTfVisibility5m, maxTfVisibility5m)
m5_end_time = (na(baseM5Start) ? na : baseM5Start + 5 * MS_IN_MIN) + end_off_ms_5m
m5_total_duration = na(m5Start) or na(m5_end_time) ? na : m5_end_time - m5Start
m5_or_end   = na(m5_total_duration) ? na : m5Start + math.round(m5_total_duration * (orDurationPct5m / 100.0))
m5_nest_end = na(m5_total_duration) ? na : m5_end_time - math.round(m5_total_duration * (ofDurationPct5m / 100.0))
manage_fractal_component(COMPONENT_FFD, m5_ffd_sessions, show_ffd_5m, is_visible_5m, "5m", color_ffd_5m, bgColor_ffd_5m, m5Start, m5_end_time, true, false, show_stdv_ffd_5m, 1004, lookbackInput, useLookback5m, lookbackCount5m)
manage_fractal_component(COMPONENT_OR, m5_or_sessions, show5mOpenRange, is_visible_5m, "5m", color5mOpenRange, bgColor5mOpenRange, m5Start, m5_or_end, true, show50PR5mOR, showStdvOR5m, 1001, lookbackInput, useLookback5m, lookbackCount5m)
manage_fractal_component(COMPONENT_NEST, m5_nest_sessions, show5mNest, is_visible_5m, "5m", color5mNest, bgColor5mNest, m5_or_end, m5_nest_end, true, false, false, 1002, lookbackInput, useLookback5m, lookbackCount5m)
manage_fractal_component(COMPONENT_OF, m5_of_sessions, show5mOpenFloat, is_visible_5m, "5m", color5mOpenFloat, bgColor5mOpenFloat, m5_nest_end, m5_end_time, true, show50PR5m, showStdvOF5m, 1003, lookbackInput, useLookback5m, lookbackCount5m)
f_manage_vdivs(show_vdiv_5m, m5Start, color_vdiv_5m, style_vdiv_5m, width_vdiv_5m, m5_vdivs, useLookback5m, lookbackCount5m)
f_manage_future_vdiv(show_future_vdiv_5m, futureM5Start, color_vdiv_5m, style_vdiv_5m, width_vdiv_5m, m5_future_vdivs)

